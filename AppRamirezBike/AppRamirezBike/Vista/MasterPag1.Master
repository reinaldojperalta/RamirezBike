 <style>
        @keyframes cart-bounce {
            0%, 100% {
                transform: scale(1);
                fill: currentColor;
            }
            50% {
                transform: scale(1.2);
                fill: red;
            }
        }

        @keyframes badge-flash {
            0%, 100% {
                background-color: #DC3545; 
                box-shadow: none;
            }
            50% {
                background-color: #28A745; 
                transform: scale(1.2);
                box-shadow: 0 0 10px rgba(40, 167, 69, 0.8);
            }
        }
        .bi-cart-plus.animate-icon {
            animation: cart-bounce 4s ease-in-out;
        }
        .contador-carrito-fijo.animate-badge {
            animation: badge-flash 4s ease-in-out;
        }
        
        .contador-carrito-fijo {
            display: none; 
        }
    </style>


</head>
