<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Dashboard.Master.cs" Inherits="AppRamirezBike.Vista.Admin.Dashboard" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <title>Panel Administrativo - RamirezBike</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
   <style>
    /* Estilos para que el Sidebar ocupe la altura completa */
    .sidebar {
        min-height: 100vh;
        background-color: #343a40; /* Fondo oscuro para el menú lateral */
        color: white;
        padding: 0;
        /* Hacemos la barra lateral fija para que no se mueva al hacer scroll */
        position: fixed; 
        top: 56px; /* Ajuste: Deja espacio debajo de la navbar superior (56px es la altura estándar de la navbar) */
        left: 0; /* Aseguramos que empiece a la izquierda */
        z-index: 1000; /* Asegura que esté sobre otros elementos si es necesario */
    }
    .sidebar a {
        color: #adb5bd;
        text-decoration: none;
        padding: 10px 15px;
        display: block;
    }
    .sidebar a:hover {
        background-color: #495057;
        color: white;
    }
    /* Ajuste para el contenido principal: debe dejar espacio para la barra lateral y la barra superior */
    .main-content {
        /* Dejamos un margen del ancho exacto del sidebar */
        margin-left: 250px; 
        /* Dejamos un padding para que el contenido no quede debajo de la navbar superior */
        padding-top: 70px !important; 
        min-height: 100vh;
    }
</style>
</head>
<body>
    <form id="form1" runat="server">

        <nav class="navbar navbar-expand-lg navbar-light bg-light fixed-top border-bottom">
            <div class="container-fluid">
                <a class="navbar-brand" href="InicioAdmin.aspx">RamirezBike</a>
                <a class="navbar-brand" href="/Vista/Catalogo.aspx"> Catalogo</a>
                
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <asp:LinkButton ID="btnLogout" runat="server"  CssClass="btn btn-outline-danger btn-sm">
                            Cerrar Sesión
                        </asp:LinkButton>
                    </li>
                </ul>
            </div>
        </nav>

        <div class="sidebar" style="width: 250px;">
            <h5 class="p-3 mt-1 text-center">Menú de Gestión</h5>
            <hr class="mx-3"/>
            <ul class="list-unstyled">
                <li><a href="InicioAdmin.aspx">Resumen</a></li>
                
                <li class="p-2 fw-bold text-secondary">GESTIÓN DE INVENTARIO</li>
                <li><a href="Productos.aspx">Ver/Editar Productos</a></li>
               
                
            </ul>
        </div>

        <div class="flex-grow-1 p-4 bg-light main-content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"> 
                </asp:ContentPlaceHolder>
        </div>
    </form>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>